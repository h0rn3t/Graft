# Graft — configuration
#
# Every command (`build`, `check`, `ask`, `grep`, `callers`, `skeleton`, `map`,
# `blast`, and `mcp`) is deterministic and local, needs no API key, and makes no
# network calls.

# --- Graph location and refresh ----------------------------------------------
# Override the default <repo>/graft context directory.
# GRAFT_DIR=/path/to/graft
# Disable automatic pre-query refresh.
# GRAFT_NO_REFRESH=1
# Verify every file by content instead of trusting size and mtime.
# GRAFT_REFRESH=hash
# Disable worktree graph seeding.
# GRAFT_NO_SEED=1

# --- Build side effects (opt-out) ---------------------------------------------
# GRAFT_NO_GITIGNORE=1
# GRAFT_NO_IGNORE=1

# --- Agent integration --------------------------------------------------------
# Command written into agent MCP configs. Default: `graft` when it is on PATH,
# otherwise the absolute path of the running graft binary.
# GRAFT_MCP_COMMAND=/usr/local/bin/graft
# Skip writing statusLine / subagentStatusLine during `graft init` (same as
# `--no-statusline`). Use this when you already have a custom Claude Code
# statusline — a project-level field would hide one in ~/.claude/settings.json.
# GRAFT_NO_STATUSLINE=1
