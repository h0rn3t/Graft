# Graft — configuration
#
# Structural commands (`build`, `check`, `ask`, `grep`, `callers`, `skeleton`,
# `map`, and `blast`) are deterministic, local, and require no API key.
# Provider settings are only needed for the optional `graft blast --name`
# labeling call.
#
# Graft is vendor-neutral: GRAFT_PROVIDER selects the wire format, not a company.

# --- Optional LLM provider (`graft blast --name`) -----------------------------
# GRAFT_PROVIDER=openai
# GRAFT_API_KEY=
# GRAFT_MODEL=openai/gpt-4o-mini
# GRAFT_BASE_URL=https://openrouter.ai/api/v1
# GRAFT_LLM_RETRIES=2

# Legacy provider fallbacks are still honored.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GRAFT_OPENROUTER_MODEL=openai/gpt-4o-mini
# ORCAROUTER_API_KEY=
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# ORCAROUTER_MODEL=openai/gpt-4o-mini

# --- Graph location and refresh ----------------------------------------------
# Override the default <repo>/graft context directory.
# GRAFT_DIR=/path/to/graft
# Disable automatic pre-query refresh.
# GRAFT_NO_REFRESH=1
# Verify every file by content instead of trusting size and mtime.
# GRAFT_REFRESH=hash
# Disable worktree graph seeding.
# GRAFT_NO_SEED=1

# --- Build side effects (opt-out) ---------------------------------------------
# GRAFT_NO_GITIGNORE=1
# GRAFT_NO_IGNORE=1

# --- Agent integration --------------------------------------------------------
# Force npx as the MCP launch command when Graft is not installed globally.
# GRAFT_MCP_NPX=1
# Skip writing statusLine / subagentStatusLine during `graft init` (same as
# `--no-statusline`). Use this when you already have a custom Claude Code
# statusline — a project-level field would hide one in ~/.claude/settings.json.
# GRAFT_NO_STATUSLINE=1

# --- Trail Brain --------------------------------------------------------------
# GRAFT_BRAIN_ID=
# GRAFT_BRAIN_TOKEN=
# GRAFT_BRAIN_URL=
# GRAFT_NO_BROWSER=1

# --- Telemetry and update checks ---------------------------------------------
# DO_NOT_TRACK=1
# GRAFT_POSTHOG_KEY=
# GRAFT_POSTHOG_HOST=https://events.nanonets.com

# --- Benchmark harness --------------------------------------------------------
# Per-role model overrides for the benchmark harness.
# BENCH_AGENT_MODEL=anthropic/claude-sonnet-5
# BENCH_JUDGE_MODEL=anthropic/claude-opus-4.8
