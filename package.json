{
  "name": "@nanonets/graft",
  "version": "0.19.0",
  "description": "Build a repo's context graph as a local, regenerable cache for coding agents.",
  "keywords": [
    "agents",
    "knowledge-graph",
    "codebase",
    "graft"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoNets/context-graph-engine.git"
  },
  "homepage": "https://github.com/NanoNets/context-graph-engine#readme",
  "bugs": {
    "url": "https://github.com/NanoNets/context-graph-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "graft": "bin/graft.js"
  },
  "files": [
    "bin",
    "scripts/postinstall.mjs",
    "scripts/build-go.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-go.mjs",
    "test": "node --test test/",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}

